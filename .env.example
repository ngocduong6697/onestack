# Copy to .env and fill in. Never commit the filled copy.
#
#   cp .env.example .env

# --- Postgres (consumed by docker-compose) ---
POSTGRES_USER=onestack
# No default anywhere: compose refuses to start without it.
POSTGRES_PASSWORD=
POSTGRES_DB=onestack

# --- Backend ---
NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgres://onestack:password@localhost:5432/onestack
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug

# --- Database pool ---
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT=30
DATABASE_CONNECT_TIMEOUT=10

# --- Tests ---
# Integration tests run against this database and DROP its public schema.
# Point it at a throwaway database, never at the one you develop against.
# Unset, the integration tests skip and say so.
TEST_DATABASE_URL=postgres://onestack:password@localhost:5432/onestack_test

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000
