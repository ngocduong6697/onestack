# Copy to .env and fill in. Never commit the filled copy.
#
#   cp .env.example .env

# --- Postgres (consumed by docker-compose) ---
POSTGRES_USER=onestack
# No default anywhere: compose refuses to start without it.
POSTGRES_PASSWORD=
POSTGRES_DB=onestack

# --- Backend ---
NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgres://onestack:password@localhost:5432/onestack_dev
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug

# --- Database pool ---
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT=30
DATABASE_CONNECT_TIMEOUT=10

# --- AI providers ---
# All optional. A provider without a key is unavailable rather than broken,
# so the API boots with none of them set. Server-side only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Rate limiting ---
# Only honoured outside production, and only by tests that are not about rate
# limiting. Production ignores it entirely.
THROTTLE_DISABLED=false

# --- Tests ---
# Integration tests run against this database and DROP its public schema.
# Point it at a throwaway database, never at the one you develop against.
# Unset, the integration tests skip and say so.
TEST_DATABASE_URL=postgres://onestack:password@localhost:5432/onestack_dev

# --- Frontend ---
# Server-side only: the browser never addresses the API, it goes through the
# Next app's own /api proxy. Deliberately not NEXT_PUBLIC_.
API_URL=http://localhost:4000
