# Copy to .env and fill in. Never commit the filled copy.
#
#   cp .env.example .env

# --- Postgres (consumed by docker-compose) ---
POSTGRES_USER=onestack
# No default anywhere: compose refuses to start without it.
POSTGRES_PASSWORD=
POSTGRES_DB=onestack

# --- Backend ---
NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgres://onestack:password@localhost:5432/onestack
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000
